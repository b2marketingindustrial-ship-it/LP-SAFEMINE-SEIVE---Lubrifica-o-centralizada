---
/**
 * Galeria de aplicações — fase "prova" da biblioteca B2, nesta LP no layout da seção
 * "Por que escolher" da COAIR que o usuário trouxe como referência em 02/11/2026, com o
 * fundo em verde escuro da marca (cor diferente do navy dos painéis): faixa de largura
 * total, cabeçalho centrado e cards brancos em três partes (foto, ícone com título e
 * descrição, rodapé com a chamada e a seta); setas do carrossel nas laterais (desktop; no celular rola por toque). O carrossel (8 segmentos) continua: trilho com scroll-snap, teclado e
 * setas. O card inteiro é o CTA. A faixa anula o padding da composição com margens
 * negativas (calculadas pelo ritmo) e repõe o respiro por dentro.
 *
 * `npm run compose` sobrescreve este arquivo com o da biblioteca: guarde-o antes.
 */
import Eyebrow from '@components/Eyebrow.astro'
import Button from '@components/Button.astro'
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { applications } from '@data/sections/aplicacoes'

type Props = SectionProps

const { tone, rhythm } = Astro.props

const at = applications.title.indexOf(applications.titleHighlight)
const before = at >= 0 ? applications.title.slice(0, at) : applications.title
const after = at >= 0 ? applications.title.slice(at + applications.titleHighlight.length) : ''

// A faixa verde anula exatamente o padding do ritmo da composição: sem isso o fundo da seção
// (branco ou cinza) aparece como uma tira acima ou abaixo do verde quando o ritmo muda.
const BAND_MARGINS: Record<string, string> = {
  'centered-lead': '-mt-4 -mb-20',
  even: '-my-16',
  flow: '-mt-6 -mb-16',
  uniform: '-my-(--section-space)',
}
const bandMargins = BAND_MARGINS[rhythm] ?? '-my-16'
---

<Section id="aplicacoes" tone={tone} rhythm={rhythm} container={false}>
  <div class:list={['apps-band relative overflow-hidden py-20 lg:py-24', bandMargins]}>
    <span class="apps-mesh pointer-events-none absolute inset-0" aria-hidden="true"></span>

    <div class="relative mx-auto max-w-page px-6 lg:px-10">
      <div class="mx-auto max-w-3xl text-center xl:max-w-none">
        <Eyebrow tone="light">{applications.eyebrow}</Eyebrow>
        <h2 class="mt-4 font-display text-[1.75rem] leading-[1.08] font-extrabold tracking-[-0.02em] text-neutral-light sm:text-[2.1rem] lg:text-[2.1rem] xl:text-[2.4rem] xl:whitespace-nowrap">
          {before}
          {at >= 0 && <span class="text-accent-orange-light">{applications.titleHighlight}</span>}
          {after}
        </h2>
        <p class="mt-5 font-sans text-[16px] leading-relaxed text-neutral-light/80 sm:text-[17px] xl:whitespace-nowrap">
          {applications.text}
        </p>
      </div>

      <div class="relative mt-10" data-carousel>
        <ul
          data-carousel-track
          tabindex="0"
          aria-label="Aplicações do SEIVE LUB"
          class="app-track -mx-6 flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth px-6 pt-2 pb-6 motion-reduce:scroll-auto lg:mx-0 lg:px-0"
        >
          {applications.items.map((app) => (
            <li class="flex w-[80%] shrink-0 snap-start sm:w-[calc((100%-1.25rem)/2)] lg:w-[calc((100%-2.5rem)/3)] xl:w-[calc((100%-3.75rem)/4)]">
              <button
                type="button"
                data-cta={`aplicacoes-${app.id}`}
                class="btn-slave-whats app-card group flex w-full flex-col overflow-hidden rounded-2xl text-left transition-[transform,border-color] duration-300 ease-out hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
              >
                <span class="relative block aspect-[4/3] overflow-hidden">
                  <Image
                    src={app.photo.src}
                    alt={app.photo.alt}
                    format="webp"
                    width={640}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.05] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                  />
                  <span
                    class="app-veil pointer-events-none absolute inset-0"
                    aria-hidden="true"
                  ></span>
                </span>

                <span class="flex flex-1 flex-col px-5 pt-5 pb-5">
                  <span class="flex items-center gap-3">
                    <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-accent-orange text-neutral-light">
                      <Icon name={app.icon} class="size-[18px]" />
                    </span>
                    <span class="font-display text-[1.1rem] leading-tight font-extrabold text-primary-dark-900">
                      {app.label}
                    </span>
                  </span>
                  <span class="mt-2 mb-4 line-clamp-2 min-h-[2lh] font-sans text-[14.5px] leading-snug text-ink-soft">
                    {app.description}
                  </span>
                  <span class="flex items-center justify-between border-t border-primary-dark/10 pt-4">
                    <span class="font-sans text-[14px] font-semibold text-primary-dark-900 transition-colors duration-200 group-hover:text-accent-orange">
                      {applications.cardCta}
                    </span>
                    <span class="flex size-9 shrink-0 items-center justify-center rounded-full border border-primary-dark/15 text-primary-dark-900 transition-[background-color,border-color,color] duration-300 group-hover:border-accent-orange group-hover:bg-accent-orange group-hover:text-neutral-light motion-reduce:transition-none">
                      <Icon name="arrow-right" class="size-4" />
                    </span>
                  </span>
                </span>
              </button>
            </li>
          ))}
        </ul>
        <div class="pointer-events-none absolute inset-y-0 -left-5 -right-5 hidden items-center justify-between lg:flex xl:-left-6 xl:-right-6">
          <button
            type="button"
            data-rail-prev
            aria-label="Aplicações anteriores"
            class="pointer-events-auto flex size-12 items-center justify-center rounded-full bg-neutral-light text-primary-dark-900 shadow-[0_10px_24px_-14px_rgb(0_0_0/0.6)] transition-colors duration-200 hover:bg-accent-orange hover:text-neutral-light disabled:opacity-0 disabled:hover:bg-neutral-light disabled:hover:text-primary-dark-900 motion-reduce:transition-none"
          >
            <Icon name="arrow-right" class="size-5 rotate-180" />
          </button>
          <button
            type="button"
            data-rail-next
            aria-label="Próximas aplicações"
            class="pointer-events-auto flex size-12 items-center justify-center rounded-full bg-neutral-light text-primary-dark-900 shadow-[0_10px_24px_-14px_rgb(0_0_0/0.6)] transition-colors duration-200 hover:bg-accent-orange hover:text-neutral-light disabled:opacity-0 disabled:hover:bg-neutral-light disabled:hover:text-primary-dark-900 motion-reduce:transition-none"
          >
            <Icon name="arrow-right" class="size-5" />
          </button>
        </div>
      </div>

      <div class="relative mt-4 flex flex-col gap-5 rounded-2xl bg-neutral-light px-6 py-5 shadow-[0_24px_48px_-28px_rgb(0_0_0/0.55)] sm:flex-row sm:items-center sm:justify-between lg:px-10">
        <div class="flex items-center gap-5">
          <span class="icon-chip size-14 rounded-full">
            <Icon name="chat" class="size-7" />
          </span>
          <p class="font-sans text-[15px] leading-snug text-ink-soft sm:text-[16px]">
            <strong class="block font-display text-[18px] font-extrabold text-primary-dark-900">
              {applications.help.title}
            </strong>
            {applications.help.text}
          </p>
        </div>
        <Button cta="aplicacoes-outra" size="md" class="shrink-0 self-start sm:self-auto">
          {cta.card}
        </Button>
      </div>
    </div>
  </div>
</Section>

<style>
  /* Verde escuro da marca, com brilho no alto e vinheta nas bordas. */
  .apps-band {
    background:
      radial-gradient(1100px 520px at 50% -10%, rgb(0 168 90 / 0.24) 0%, transparent 60%),
      var(--color-brand-green-900);
  }

  /* Malha de pontos clara, esmaecida no meio para não disputar com os cards. */
  .apps-mesh {
    background-image: radial-gradient(circle, rgb(255 255 255 / 0.12) 1px, transparent 1.2px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse at 50% 50%, transparent 30%, black 100%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 50%, transparent 30%, black 100%);
  }

  .app-card {
    background-color: var(--color-neutral-light);
    box-shadow: 0 24px 48px -28px rgb(0 0 0 / 0.55);
  }

  .app-card:hover {
    box-shadow: 0 32px 60px -28px rgb(0 0 0 / 0.65);
  }

  /* A foto se dissolve no corpo escuro do card. */
  /* Leve escurecimento no pé da foto, para a emenda com o card branco ficar limpa. */
  .app-veil {
    background: linear-gradient(to top, rgb(0 0 0 / 0.18) 0%, transparent 40%);
  }

  .app-track {
    scrollbar-width: none;
  }

  .app-track::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // Setas do carrossel: andam uma tela de cards por vez e desligam nas pontas.
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]')
    const prev = root.querySelector<HTMLButtonElement>('[data-rail-prev]')
    const next = root.querySelector<HTMLButtonElement>('[data-rail-next]')
    if (!track || !prev || !next) return

    const update = () => {
      prev.disabled = track.scrollLeft <= 4
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4
    }
    const go = (dir: number) => track.scrollBy({ left: dir * track.clientWidth * 0.9 })

    prev.addEventListener('click', () => go(-1))
    next.addEventListener('click', () => go(1))
    track.addEventListener('scroll', update, { passive: true })
    window.addEventListener('resize', update)
    update()
  })
</script>

---
/**
 * Galeria de aplicações — fase "prova" da biblioteca B2, nesta LP no layout da seção
 * "Por que escolher" da COAIR que o usuário trouxe como referência em 02/11/2026, com o
 * fundo em verde escuro da marca (cor diferente do navy dos painéis): faixa de largura
 * total, cabeçalho centrado e cards em três partes: foto que se dissolve no corpo do
 * card (mesma cor, sem emenda), ícone com título e descrição, e rodapé com a chamada e a seta. O carrossel (8 segmentos) continua: trilho com scroll-snap, teclado e
 * setas. O card inteiro é o CTA. A faixa anula o padding da composição com margens
 * negativas e repõe o respiro por dentro.
 *
 * `npm run compose` sobrescreve este arquivo com o da biblioteca: guarde-o antes.
 */
import Eyebrow from '@components/Eyebrow.astro'
import Button from '@components/Button.astro'
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { applications } from '@data/sections/aplicacoes'

type Props = SectionProps

const { tone, rhythm } = Astro.props

const at = applications.title.indexOf(applications.titleHighlight)
const before = at >= 0 ? applications.title.slice(0, at) : applications.title
const after = at >= 0 ? applications.title.slice(at + applications.titleHighlight.length) : ''
---

<Section id="aplicacoes" tone={tone} rhythm={rhythm} container={false}>
  <div class="apps-band relative -mt-4 -mb-20 overflow-hidden py-20 lg:py-24">
    <span class="apps-mesh pointer-events-none absolute inset-0" aria-hidden="true"></span>

    <div class="relative mx-auto max-w-page px-6 lg:px-10">
      <div class="mx-auto max-w-3xl text-center xl:max-w-none">
        <Eyebrow tone="light">{applications.eyebrow}</Eyebrow>
        <h2 class="mt-4 font-display text-[1.75rem] leading-[1.08] font-extrabold tracking-[-0.02em] text-neutral-light sm:text-[2.1rem] lg:text-[2.1rem] xl:text-[2.4rem] xl:whitespace-nowrap">
          {before}
          {at >= 0 && <span class="text-accent-orange-light">{applications.titleHighlight}</span>}
          {after}
        </h2>
        <p class="mt-5 font-sans text-[16px] leading-relaxed text-neutral-light/80 sm:text-[17px] xl:whitespace-nowrap">
          {applications.text}
        </p>
      </div>

      <div class="mt-10" data-carousel>
        <div class="mb-4 flex justify-end gap-2">
          <button
            type="button"
            data-rail-prev
            aria-label="Aplicações anteriores"
            class="flex size-11 items-center justify-center rounded-full border border-white/20 text-neutral-light transition-colors duration-200 hover:border-accent-orange-light hover:text-accent-orange-light disabled:opacity-30 disabled:hover:border-white/20 disabled:hover:text-neutral-light motion-reduce:transition-none"
          >
            <Icon name="arrow-right" class="size-5 rotate-180" />
          </button>
          <button
            type="button"
            data-rail-next
            aria-label="Próximas aplicações"
            class="flex size-11 items-center justify-center rounded-full border border-white/20 text-neutral-light transition-colors duration-200 hover:border-accent-orange-light hover:text-accent-orange-light disabled:opacity-30 disabled:hover:border-white/20 disabled:hover:text-neutral-light motion-reduce:transition-none"
          >
            <Icon name="arrow-right" class="size-5" />
          </button>
        </div>

        <ul
          data-carousel-track
          tabindex="0"
          aria-label="Aplicações do SEIVE LUB"
          class="app-track -mx-6 flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth px-6 pt-2 pb-4 motion-reduce:scroll-auto lg:mx-0 lg:px-0"
        >
          {applications.items.map((app) => (
            <li class="flex w-[80%] shrink-0 snap-start sm:w-[calc((100%-1.25rem)/2)] lg:w-[calc((100%-2.5rem)/3)] xl:w-[calc((100%-3.75rem)/4)]">
              <button
                type="button"
                data-cta={`aplicacoes-${app.id}`}
                class="btn-slave-whats app-card group flex w-full flex-col overflow-hidden rounded-2xl text-left transition-[transform,border-color] duration-300 ease-out hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
              >
                <span class="relative block aspect-[4/3] overflow-hidden">
                  <Image
                    src={app.photo.src}
                    alt={app.photo.alt}
                    format="webp"
                    width={640}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.05] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                  />
                  <span
                    class="app-veil pointer-events-none absolute inset-0"
                    aria-hidden="true"
                  ></span>
                </span>

                <span class="flex flex-1 flex-col px-5 pt-5 pb-5">
                  <span class="flex items-center gap-3">
                    <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-accent-orange text-neutral-light">
                      <Icon name={app.icon} class="size-[18px]" />
                    </span>
                    <span class="font-display text-[1.1rem] leading-tight font-extrabold text-neutral-light">
                      {app.label}
                    </span>
                  </span>
                  <span class="mt-3 mb-5 font-sans text-[14.5px] leading-snug text-neutral-light/75">
                    {app.description}
                  </span>
                  <span class="mt-auto flex items-center justify-between border-t border-white/10 pt-4">
                    <span class="font-sans text-[14px] font-semibold text-neutral-light transition-colors duration-200 group-hover:text-accent-orange-light">
                      {applications.cardCta}
                    </span>
                    <span class="flex size-9 shrink-0 items-center justify-center rounded-full border border-white/25 text-neutral-light transition-[background-color,border-color] duration-300 group-hover:border-accent-orange group-hover:bg-accent-orange motion-reduce:transition-none">
                      <Icon name="arrow-right" class="size-4" />
                    </span>
                  </span>
                </span>
              </button>
            </li>
          ))}
        </ul>
      </div>

      <div class="app-help relative mt-4 flex flex-col gap-5 rounded-2xl px-6 py-5 sm:flex-row sm:items-center sm:justify-between lg:px-10">
        <div class="flex items-center gap-5">
          <span class="flex size-14 shrink-0 items-center justify-center rounded-full border border-white/15 bg-white/[0.06] text-accent-orange-light">
            <Icon name="chat" class="size-7" />
          </span>
          <p class="font-sans text-[15px] leading-snug text-neutral-light/80 sm:text-[16px]">
            <strong class="block font-display text-[18px] font-extrabold text-neutral-light">
              {applications.help.title}
            </strong>
            {applications.help.text}
          </p>
        </div>
        <Button cta="aplicacoes-outra" size="md" class="shrink-0 self-start sm:self-auto">
          {cta.card}
        </Button>
      </div>
    </div>
  </div>
</Section>

<style>
  /* Verde escuro da marca, com brilho no alto e vinheta nas bordas. */
  .apps-band {
    background:
      radial-gradient(1100px 520px at 50% -10%, rgb(123 162 73 / 0.28) 0%, transparent 60%),
      var(--color-brand-green-900);
  }

  /* Malha de pontos clara, esmaecida no meio para não disputar com os cards. */
  .apps-mesh {
    background-image: radial-gradient(circle, rgb(255 255 255 / 0.12) 1px, transparent 1.2px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse at 50% 50%, transparent 30%, black 100%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 50%, transparent 30%, black 100%);
  }

  .app-card {
    border: 1px solid rgb(255 255 255 / 0.12);
    background-color: var(--color-brand-green-800);
  }

  .app-help {
    border: 1px solid rgb(255 255 255 / 0.14);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.06) 0%, rgb(255 255 255 / 0.02) 100%);
  }

  .app-card:hover {
    border-color: rgb(123 162 73 / 0.7);
  }

  /* A foto se dissolve no corpo escuro do card. */
  .app-veil {
    background: linear-gradient(to top, var(--color-brand-green-800) 0%, transparent 45%);
  }

  .app-track {
    scrollbar-width: none;
  }

  .app-track::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // Setas do carrossel: andam uma tela de cards por vez e desligam nas pontas.
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]')
    const prev = root.querySelector<HTMLButtonElement>('[data-rail-prev]')
    const next = root.querySelector<HTMLButtonElement>('[data-rail-next]')
    if (!track || !prev || !next) return

    const update = () => {
      prev.disabled = track.scrollLeft <= 4
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4
    }
    const go = (dir: number) => track.scrollBy({ left: dir * track.clientWidth * 0.9 })

    prev.addEventListener('click', () => go(-1))
    next.addEventListener('click', () => go(1))
    track.addEventListener('scroll', update, { passive: true })
    window.addEventListener('resize', update)
    update()
  })
</script>

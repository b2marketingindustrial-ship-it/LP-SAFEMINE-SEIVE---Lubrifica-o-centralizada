---
/**
 * Clientes — biblioteca B2, fase prova. Clientes da SEIVE (aval registrado no BRIEFING),
 * agrupados por setor como na página 5 do catálogo.
 *
 * Cabeçalho em duas colunas e, abaixo, um painel com uma linha por setor: rótulo à
 * esquerda e os logos daquele setor correndo num carrossel contínuo à direita. As linhas
 * alternam a direção; o carrossel para no hover e fica parado com reduced-motion. A lista
 * de cada setor é repetida até encher o trilho, para o loop não ter buraco. Logos em cinza
 * (disfarça a baixa resolução) que ganham cor no hover. No pé, a linha de CTA.
 */
import { Image } from 'astro:assets'
import Button from '@components/Button.astro'
import Icon from '@components/Icon.astro'
import Section from '@components/Section.astro'
import SplitHeader from '@components/SplitHeader.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { clients } from '@data/sections/clientes'

type Props = SectionProps

const { tone, rhythm } = Astro.props

// Cada metade do trilho precisa de pelo menos ~8 logos para cobrir a largura.
const groups = clients.sectors.map((sector) => {
  const logos = clients.logos.filter((logo) => logo.sector === sector.id)
  const repeat = Math.max(1, Math.ceil(8 / logos.length))
  return { ...sector, logos, half: Array.from({ length: repeat }, () => logos).flat() }
})
---

<Section id="clientes" tone={tone} rhythm={rhythm}>
  <SplitHeader
    eyebrow={clients.eyebrow}
    title={clients.title}
    highlight={clients.titleHighlight}
    text={clients.text}
  />

  <div class="mt-10 overflow-hidden rounded-[1.5rem] border border-primary-dark/10 bg-neutral-light card-shadow">
    <ul>
      {groups.map((group, row) => (
        <li class="grid border-b border-primary-dark/10 sm:grid-cols-[12rem_minmax(0,1fr)] sm:items-center">
          <span class="flex items-center gap-3 px-5 pt-5 sm:border-r sm:border-primary-dark/10 sm:px-7 sm:py-6">
            <span class="icon-chip size-9">
              <Icon name={group.icon} class="size-[18px]" />
            </span>
            <span class="font-display text-[15px] font-extrabold text-primary-dark-900">
              {group.label}
            </span>
          </span>

          <div class="clients-marquee overflow-hidden py-5 sm:py-6">
            <ul class="sr-only">
              {group.logos.map((logo) => (
                <li>{logo.alt}</li>
              ))}
            </ul>
            <div
              class:list={['clients-track flex w-max items-center', row % 2 === 1 && 'is-reverse']}
              aria-hidden="true"
            >
              {[0, 1].map(() =>
                group.half.map((logo) => (
                  <span class="flex h-10 w-40 shrink-0 items-center justify-center px-6">
                    <Image
                      src={logo.src}
                      alt=""
                      height={48}
                      format="webp"
                      loading="lazy"
                      decoding="async"
                      class="client-logo max-h-8 w-auto max-w-full object-contain"
                    />
                  </span>
                )),
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>

    <div class="flex flex-col gap-4 bg-neutral-gray-100/60 px-6 py-5 sm:flex-row sm:items-center sm:justify-between lg:px-8">
      <p class="font-sans text-[15px] font-semibold text-primary-dark-900">{clients.ctaText}</p>
      <Button cta="clientes-cta" size="md" class="self-start sm:self-auto">
        {cta.card}
      </Button>
    </div>
  </div>
</Section>

<style>
  .clients-marquee {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      black 56px,
      black calc(100% - 56px),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      black 56px,
      black calc(100% - 56px),
      transparent 100%
    );
  }

  .clients-track {
    animation: clients-scroll 40s linear infinite;
  }

  .clients-track.is-reverse {
    animation-direction: reverse;
  }

  .clients-marquee:hover .clients-track {
    animation-play-state: paused;
  }

  @keyframes clients-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .client-logo {
    filter: grayscale(1);
    opacity: 0.7;
    transition:
      filter 300ms ease,
      opacity 300ms ease;
  }

  .clients-marquee:hover .client-logo {
    filter: none;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .clients-track {
      animation: none;
    }

    .client-logo {
      transition: none;
    }
  }
</style>

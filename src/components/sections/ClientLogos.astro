---
/**
 * Clientes e números — biblioteca B2, fase prova. Nesta LP os logos (clientes da SEIVE,
 * com aval registrado no BRIEFING) correm num carrossel contínuo em escala de cinza, que
 * ganha cor e para no hover e fica parado com `prefers-reduced-motion`. Abaixo, uma
 * régua com os 2 números e o CTA.
 */
import { Image } from 'astro:assets'
import Button from '@components/Button.astro'
import Section from '@components/Section.astro'
import SplitHeader from '@components/SplitHeader.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { clients } from '@data/sections/clientes'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section id="clientes" tone={tone} rhythm={rhythm}>
  <SplitHeader
    eyebrow={clients.eyebrow}
    title={clients.title}
    highlight={clients.titleHighlight}
    text={clients.text}
  />

  <div class="relative mt-10 overflow-hidden rounded-[1.5rem] border border-primary-dark/10 bg-neutral-light card-shadow">
    <div class="clients-marquee relative py-12">
      <div class="clients-track flex w-max items-center">
        {/* Lista duplicada para o loop ficar contínuo; a cópia some para leitor de tela. */}
        {[0, 1].map((copy) => (
          <ul class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
            {clients.logos.map((logo) => (
              <li class="flex h-12 w-48 shrink-0 items-center justify-center px-7">
                <Image
                  src={logo.src}
                  alt={copy === 1 ? '' : logo.alt}
                  height={48}
                  format="webp"
                  loading="lazy"
                  decoding="async"
                  class="client-logo max-h-10 w-auto object-contain"
                />
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>

    <div class="relative flex flex-col gap-4 border-t border-primary-dark/10 bg-neutral-gray-100/60 px-6 py-5 sm:flex-row sm:items-center sm:justify-between lg:px-8">
      <p class="font-sans text-[15px] text-ink">{clients.ctaText}</p>
      <Button cta="clientes-cta" size="md" class="self-start sm:self-auto">
        {cta.card}
      </Button>
    </div>
  </div>
</Section>

<style>
  .clients-marquee {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      black 72px,
      black calc(100% - 72px),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      black 72px,
      black calc(100% - 72px),
      transparent 100%
    );
  }

  .clients-track {
    animation: clients-scroll 52s linear infinite;
  }

  /* Cinza por padrão (disfarça a baixa resolução); cor e pausa no hover. */
  .client-logo {
    filter: grayscale(1);
    opacity: 0.7;
    transition:
      filter 300ms ease,
      opacity 300ms ease;
  }

  .clients-marquee:hover .clients-track {
    animation-play-state: paused;
  }

  .clients-marquee:hover .client-logo {
    filter: none;
    opacity: 1;
  }

  @keyframes clients-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .clients-track {
      animation: none;
    }

    .client-logo {
      transition: none;
    }
  }
</style>

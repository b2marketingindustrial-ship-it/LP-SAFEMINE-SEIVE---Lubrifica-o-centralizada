---
/**
 * Clientes — biblioteca B2, fase prova. Clientes da SEIVE (aval registrado no BRIEFING).
 *
 * Só o cabeçalho e os logos em carrossel contínuo: duas faixas, uma para cada lado, sem
 * tabela, rótulos de setor nem CTA (pedido do usuário, 03/11/2026). Para no hover e fica
 * parado com reduced-motion. Logos em cinza (disfarça a baixa resolução) que ganham cor
 * no hover. Os setores continuam nos dados, para uso futuro.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import SplitHeader from '@components/SplitHeader.astro'
import type { SectionProps } from '@lib/layout'
import { clients } from '@data/sections/clientes'

type Props = SectionProps

const { tone, rhythm } = Astro.props

const middle = Math.ceil(clients.logos.length / 2)
const rows = [clients.logos.slice(0, middle), clients.logos.slice(middle)]
---

<Section id="clientes" tone={tone} rhythm={rhythm}>
  <SplitHeader
    eyebrow={clients.eyebrow}
    title={clients.title}
    highlight={clients.titleHighlight}
    text={clients.text}
  />

  <ul class="sr-only">
    {clients.logos.map((logo) => (
      <li>{logo.alt}</li>
    ))}
  </ul>

  <div class="mt-10 flex flex-col gap-4" aria-hidden="true">
    {rows.map((row, i) => (
      <div class="clients-marquee overflow-hidden">
        <div class:list={['clients-track flex w-max items-center gap-4', i === 1 && 'is-reverse']}>
          {[0, 1].map(() =>
            row.map((logo) => (
              <span class="client-tile flex h-20 w-48 shrink-0 items-center justify-center rounded-2xl border border-primary-dark/10 bg-neutral-light px-7">
                <Image
                  src={logo.src}
                  alt=""
                  height={48}
                  format="webp"
                  loading="lazy"
                  decoding="async"
                  class="client-logo max-h-9 w-auto max-w-full object-contain"
                />
              </span>
            )),
          )}
        </div>
      </div>
    ))}
  </div>
</Section>

<style>
  .clients-marquee {
    padding-block: 0.25rem;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      black 80px,
      black calc(100% - 80px),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      black 80px,
      black calc(100% - 80px),
      transparent 100%
    );
  }

  /* O gap entra na conta do loop: cada metade termina com o mesmo respiro do começo. */
  .clients-track {
    padding-right: 1rem;
    animation: clients-scroll 45s linear infinite;
  }

  .clients-track.is-reverse {
    animation-direction: reverse;
  }

  .clients-marquee:hover .clients-track {
    animation-play-state: paused;
  }

  @keyframes clients-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 0.5rem));
    }
  }

  .client-logo {
    filter: grayscale(1);
    opacity: 0.7;
    transition:
      filter 300ms ease,
      opacity 300ms ease;
  }

  .client-tile:hover .client-logo {
    filter: none;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .clients-track {
      animation: none;
    }

    .client-logo {
      transition: none;
    }
  }
</style>

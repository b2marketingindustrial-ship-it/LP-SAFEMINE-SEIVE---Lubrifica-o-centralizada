---
/**
 * Clientes — biblioteca B2, fase prova. Reformulada em 03/11/2026: em vez do carrossel,
 * os logos (clientes da SEIVE, com aval registrado no BRIEFING) ficam parados e agrupados
 * por setor, como na página 5 do catálogo, para mostrar alcance em cada setor.
 *
 * Duas colunas: à esquerda o cabeçalho, o texto e o CTA (fixos ao rolar no desktop); à
 * direita um painel com uma linha por setor (ícone e nome, depois os logos em placas).
 * Logos em cinza que ganham cor no hover; a escala de cinza disfarça a baixa resolução.
 */
import { Image } from 'astro:assets'
import Button from '@components/Button.astro'
import Eyebrow from '@components/Eyebrow.astro'
import Icon from '@components/Icon.astro'
import Section from '@components/Section.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { clients } from '@data/sections/clientes'

type Props = SectionProps

const { tone, rhythm } = Astro.props

const at = clients.title.indexOf(clients.titleHighlight)
const before = at >= 0 ? clients.title.slice(0, at) : clients.title
const after = at >= 0 ? clients.title.slice(at + clients.titleHighlight.length) : ''

const groups = clients.sectors.map((sector) => ({
  ...sector,
  logos: clients.logos.filter((logo) => logo.sector === sector.id),
}))
---

<Section id="clientes" tone={tone} rhythm={rhythm}>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-14">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <Eyebrow>{clients.eyebrow}</Eyebrow>
      <h2 class="mt-4 font-display text-[1.75rem] leading-[1.08] font-extrabold tracking-[-0.02em] text-primary-dark-900 sm:text-[2.1rem] lg:text-[2.1rem] xl:text-[2.4rem]">
        {before}
        {at >= 0 && <span class="text-accent-orange">{clients.titleHighlight}</span>}
        {after}
      </h2>
      <p class="mt-4 max-w-[26rem] font-sans text-[16px] leading-relaxed text-ink-soft sm:text-[17px]">
        {clients.text}
      </p>
      <p class="mt-8 font-sans text-[15px] font-semibold text-primary-dark-900">
        {clients.ctaText}
      </p>
      <Button cta="clientes-cta" size="md" class="mt-4">
        {cta.card}
      </Button>
    </div>

    <ul class="overflow-hidden rounded-[1.5rem] border border-primary-dark/10 bg-neutral-light card-shadow">
      {groups.map((group) => (
        <li class="grid gap-4 border-b border-primary-dark/10 px-5 py-5 last:border-b-0 sm:grid-cols-[9.5rem_minmax(0,1fr)] sm:items-center sm:gap-6 sm:px-7">
          <span class="flex items-center gap-3">
            <span class="icon-chip size-9">
              <Icon name={group.icon} class="size-[18px]" />
            </span>
            <span class="font-display text-[15px] font-extrabold text-primary-dark-900">
              {group.label}
            </span>
          </span>
          <ul
            class="grid grid-cols-2 gap-2.5 sm:flex sm:flex-wrap"
            aria-label={`Clientes SEIVE em ${group.label}`}
          >
            {group.logos.map((logo) => (
              <li class="client-tile flex h-14 w-full items-center sm:w-[8.5rem] justify-center rounded-xl border border-primary-dark/[0.08] bg-neutral-gray-100 px-4">
                <Image
                  src={logo.src}
                  alt={logo.alt}
                  height={48}
                  format="webp"
                  loading="lazy"
                  decoding="async"
                  class="client-logo max-h-8 w-auto max-w-full object-contain"
                />
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</Section>

<style>
  .client-logo {
    filter: grayscale(1);
    opacity: 0.75;
    transition:
      filter 300ms ease,
      opacity 300ms ease;
  }

  .client-tile:hover .client-logo {
    filter: none;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .client-logo {
      transition: none;
    }
  }
</style>

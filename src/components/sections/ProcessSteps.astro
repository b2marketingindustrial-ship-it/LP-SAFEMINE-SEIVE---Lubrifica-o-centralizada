---
/**
 * Como funciona (etapas) — biblioteca B2, fase apoio. É o bloco navy da primeira metade
 * da página (o "identificar" ficou claro), no layout do painel de dados da COAIR que o
 * usuário trouxe como referência em 02/11/2026: painel navy com cantos técnicos, malha de
 * blueprint e o esquemático da instalação em marca d'água à direita; cabeçalho e texto à
 * esquerda, CTA e reforço à direita; abaixo, as 4 etapas numeradas em pílulas numa linha.
 */
import Eyebrow from '@components/Eyebrow.astro'
import { Image } from 'astro:assets'
import Button from '@components/Button.astro'
import Icon from '@components/Icon.astro'
import Section from '@components/Section.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { processSteps } from '@data/sections/processo'
import { solution } from '@data/sections/solucao'

type Props = SectionProps

const { tone, rhythm } = Astro.props

const at = processSteps.title.indexOf(processSteps.titleHighlight)
const before = at >= 0 ? processSteps.title.slice(0, at) : processSteps.title
const after = at >= 0 ? processSteps.title.slice(at + processSteps.titleHighlight.length) : ''
---

<Section id="processo" tone={tone} rhythm={rhythm}>
  <div class="navy-panel tech-corners panel-shadow relative overflow-hidden rounded-[1.5rem] px-6 py-9 sm:px-10 sm:py-11 lg:px-12 lg:py-12">
    <span class="blueprint-grid pointer-events-none absolute inset-0" aria-hidden="true"></span>
    {/* Esquemático em marca d'água: só no desktop, atrás do CTA. */}
    <Image
      src={solution.scheme.src}
      alt=""
      format="webp"
      width={1200}
      loading="lazy"
      decoding="async"
      aria-hidden="true"
      class="process-ghost pointer-events-none absolute -right-12 top-1/2 hidden w-[46%] -translate-y-1/2 lg:block"
    />

    <div class="relative grid gap-8 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:items-start lg:gap-12">
      <div>
        <Eyebrow tone="light">{processSteps.eyebrow}</Eyebrow>
        <h2 class="mt-4 font-display text-[1.75rem] leading-[1.08] font-extrabold tracking-[-0.02em] text-neutral-light sm:text-[2.1rem] lg:text-[2.1rem] xl:text-[2.4rem]">
          {before}
          {at >= 0 && <span class="text-accent-orange-light">{processSteps.titleHighlight}</span>}
          {after}
        </h2>
        <p class="mt-5 max-w-[36rem] font-sans text-[16px] leading-relaxed text-neutral-light/80 sm:text-[17px]">
          {processSteps.text}
        </p>
      </div>

      <div class="glass-card flex flex-col gap-4 rounded-2xl p-5 lg:ml-auto lg:w-full lg:max-w-[22rem]">
        <p class="flex items-start gap-3 font-display text-[16px] leading-snug font-extrabold text-neutral-light">
          <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-accent-orange text-neutral-light">
            <Icon name="check" class="size-4" />
          </span>
          {processSteps.microcopy}
        </p>
        <Button cta="processo-cta" size="md" class="w-full">
          {cta.card}
        </Button>
      </div>
    </div>

    <ol class="relative mt-9 grid gap-3 sm:grid-cols-2 lg:mt-10 lg:grid-cols-4">
      {processSteps.items.map((step, i) => (
        <li class="step-pill flex items-start gap-4 rounded-xl px-5 py-4">
          <span class="relative flex size-11 shrink-0 items-center justify-center rounded-full border border-white/20 bg-white/[0.06] text-accent-orange-light">
            <Icon name={step.icon} class="size-5" />
            <span class="absolute -top-1.5 -right-1.5 flex size-5 items-center justify-center rounded-full bg-accent-orange font-sans text-[11px] font-bold text-neutral-light tabular-nums">
              {i + 1}
            </span>
          </span>
          <span class="min-w-0">
            <h3 class="font-display text-[15px] leading-snug font-extrabold text-neutral-light sm:text-[16px]">
              {step.title}
            </h3>
            <p class="mt-1 font-sans text-[13.5px] leading-snug text-neutral-light/75">
              {step.description}
            </p>
          </span>
        </li>
      ))}
    </ol>
  </div>
</Section>

<style>
  /* Esquemático como traço claro: tira a cor, inverte e deixa quase transparente. */
  .process-ghost {
    filter: grayscale(1) invert(1) brightness(1.6);
    opacity: 0.16;
    mix-blend-mode: screen;
  }

  .step-pill {
    border: 1px solid rgb(255 255 255 / 0.14);
    background: linear-gradient(160deg, rgb(255 255 255 / 0.08) 0%, rgb(255 255 255 / 0.02) 100%);
  }
</style>

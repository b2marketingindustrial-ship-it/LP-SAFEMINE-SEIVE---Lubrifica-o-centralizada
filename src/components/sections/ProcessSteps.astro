---
/**
 * Como funciona (etapas) — biblioteca B2, fase apoio. Variante clara nesta LP: o bloco
 * navy da fase continua sendo o "identificar" (docs/BRIEFING.md). 4 etapas numeradas,
 * ligadas por uma linha no desktop, e o CTA com a linha de reforço.
 */
import Button from '@components/Button.astro'
import Icon from '@components/Icon.astro'
import Section from '@components/Section.astro'
import SplitHeader from '@components/SplitHeader.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { processSteps } from '@data/sections/processo'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section id="processo" tone={tone} rhythm={rhythm}>
  <SplitHeader
    eyebrow={processSteps.eyebrow}
    title={processSteps.title}
    highlight={processSteps.titleHighlight}
    text={processSteps.text}
  />

  <ol class="process-steps relative mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
    {processSteps.items.map((step, i) => (
      <li class="relative">
        <span class="relative z-[1] flex size-14 items-center justify-center rounded-full border border-primary-dark/10 bg-neutral-light text-primary-dark-900 shadow-[0_10px_24px_-16px_rgba(10,29,77,0.5)]">
          <Icon name={step.icon} class="size-6" />
          <span class="absolute -top-1 -right-1 flex size-6 items-center justify-center rounded-full bg-accent-orange font-sans text-[12px] font-bold text-neutral-light">
            {i + 1}
          </span>
        </span>
        <h3 class="mt-5 font-display text-[1.1rem] leading-snug font-extrabold text-primary-dark-900">
          {step.title}
        </h3>
        <p class="mt-1.5 max-w-[17rem] font-sans text-[15px] leading-snug text-ink-soft">
          {step.description}
        </p>
      </li>
    ))}
  </ol>

  <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
    <Button cta="processo-cta" size="md" class="self-start">
      {cta.card}
    </Button>
    <p class="flex items-center gap-3 font-sans text-[15px] text-ink-soft">
      <Icon name="check" class="size-5 shrink-0 text-accent-orange" />
      {processSteps.microcopy}
    </p>
  </div>
</Section>

<style>
  /* Linha que liga os quatro círculos no desktop, atrás deles. */
  @media (width >= 64rem) {
    .process-steps::before {
      content: '';
      position: absolute;
      top: 1.75rem;
      right: 12%;
      left: 1.75rem;
      border-top: 2px dashed rgb(16 44 115 / 0.18);
    }
  }
</style>

---
/**
 * "A solução" — seção própria desta LP (fase oferta), logo abaixo do hero.
 *
 * Duas colunas na mesma altura (03/11/2026): à esquerda o título, uma frase, as 4
 * finalidades em grade 2×2 e o CTA; à direita o esquemático da instalação numa placa leve
 * que estica até a altura do texto, com a ficha técnica em selos numa linha só no desktop.
 */
import Eyebrow from '@components/Eyebrow.astro'
import { Image } from 'astro:assets'
import Button from '@components/Button.astro'
import Icon from '@components/Icon.astro'
import Section from '@components/Section.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { solution } from '@data/sections/solucao'

type Props = SectionProps

const { tone, rhythm } = Astro.props

const at = solution.title.indexOf(solution.titleHighlight)
const before = at >= 0 ? solution.title.slice(0, at) : solution.title
const after = at >= 0 ? solution.title.slice(at + solution.titleHighlight.length) : ''
---

<Section id="solucao" tone={tone} rhythm={rhythm}>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:items-stretch lg:gap-14">
    <div>
      <Eyebrow>{solution.eyebrow}</Eyebrow>
      <h2 class="mt-4 font-display text-[1.75rem] leading-[1.08] font-extrabold tracking-[-0.02em] text-primary-dark-900 sm:text-[2.1rem] lg:text-[2.1rem] xl:text-[2.4rem]">
        {before}
        {at >= 0 && <span class="text-accent-orange">{solution.titleHighlight}</span>}
        {after}
      </h2>
      <p class="mt-4 max-w-[32rem] font-sans text-[16px] leading-relaxed text-ink-soft sm:text-[17px]">
        {solution.lead}
      </p>

      <ul class="mt-7 grid gap-x-6 gap-y-5 sm:grid-cols-2">
        {solution.purposes.map((item) => (
          <li class="flex items-start gap-3">
            <span class="icon-chip mt-0.5 size-9">
              <Icon name={item.icon} class="size-[18px]" />
            </span>
            <span>
              <h3 class="font-display text-[15.5px] leading-snug font-extrabold text-primary-dark-900">
                {item.title}
              </h3>
              <p class="font-sans text-[14px] leading-snug text-ink-soft">{item.description}</p>
            </span>
          </li>
        ))}
      </ul>

      <Button cta="solucao-cta" size="md" class="mt-8">
        {cta.card}
      </Button>
    </div>

    <figure class="relative flex flex-col rounded-[1.5rem] border border-primary-dark/[0.06] bg-neutral-gray-100 px-5 pt-6 pb-5 sm:px-8 sm:pt-8">
      <span
        class="dot-grid pointer-events-none absolute inset-0 rounded-[1.5rem] opacity-60"
        aria-hidden="true"
      ></span>
      {/* O desenho ocupa a sobra de altura, centrado: a placa acompanha a coluna de texto. */}
      <div class="relative flex flex-1 items-center justify-center">
        <Image
          src={solution.scheme.src}
          alt={solution.scheme.alt}
          format="webp"
          width={1200}
          loading="lazy"
          decoding="async"
          class="relative mx-auto w-full object-contain"
        />
      </div>
      <ul
        class="relative mt-4 flex flex-wrap justify-center gap-2 lg:flex-nowrap"
        aria-label="Ficha técnica"
      >
        {solution.facts.map((fact) => (
          <li class="rounded-full border border-primary-dark/10 bg-neutral-light px-3.5 py-1.5 font-sans text-[13px] whitespace-nowrap text-ink-soft">
            {fact.label}: <strong class="font-semibold text-primary-dark-900">{fact.value}</strong>
          </li>
        ))}
      </ul>
    </figure>
  </div>
</Section>

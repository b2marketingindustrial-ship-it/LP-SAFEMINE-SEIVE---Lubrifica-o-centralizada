---
/**
 * "Por que investir" — seção própria desta LP (fase prova), fora da biblioteca B2.
 *
 * Simplificada em 02/11/2026 (o usuário achou a lista em 3 colunas densa): os 6
 * benefícios numa grade 3×2 de itens curtos (ícone, título, uma frase) e, abaixo, uma
 * faixa navy só com as duas estatísticas, a fonte e o CTA.
 */
import Button from '@components/Button.astro'
import Icon from '@components/Icon.astro'
import Section from '@components/Section.astro'
import SplitHeader from '@components/SplitHeader.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { benefits } from '@data/sections/beneficios'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section id="beneficios" tone={tone} rhythm={rhythm} class="rounded-t-[2rem] sm:rounded-t-[3rem]">
  <SplitHeader
    eyebrow={benefits.eyebrow}
    title={benefits.title}
    highlight={benefits.titleHighlight}
    text={benefits.text}
  />

  <ul class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
    {benefits.items.map((item) => (
      <li class="flex items-start gap-4">
        <span class="icon-chip size-11">
          <Icon name={item.icon} class="size-5" />
        </span>
        <span>
          <h3 class="font-display text-[1.05rem] leading-snug font-extrabold text-primary-dark-900">
            {item.title}
          </h3>
          <p class="mt-1 font-sans text-[15px] leading-snug text-ink-soft">{item.description}</p>
        </span>
      </li>
    ))}
  </ul>

  <div class="navy-panel panel-shadow relative mt-12 overflow-hidden rounded-[1.5rem] px-6 py-8 sm:px-10 lg:px-12 lg:py-9">
    <span class="blueprint-grid pointer-events-none absolute inset-0" aria-hidden="true"></span>
    <div class="relative grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)_minmax(0,0.9fr)] lg:items-center lg:gap-10">
      <p class="font-display text-[1.6rem] leading-[1.1] font-extrabold tracking-[-0.02em] text-neutral-light sm:text-[1.9rem]">
        {benefits.stats.title}
      </p>
      <dl class="grid gap-6 sm:grid-cols-2 sm:gap-8">
        {benefits.stats.items.map((stat) => (
          <div class="flex flex-col border-l border-white/15 pl-5">
            <dt class="order-2 mt-1 font-sans text-[14.5px] leading-snug text-neutral-light/80">
              {stat.label}
            </dt>
            <dd class="order-1 font-sans text-[12px] font-semibold tracking-[0.14em] text-neutral-light/60 uppercase">
              {stat.prefix}
              <span class="block font-display text-[2.4rem] leading-none font-extrabold tracking-[-0.03em] text-neutral-light normal-case tabular-nums">
                {stat.value}
              </span>
            </dd>
          </div>
        ))}
      </dl>
      <div class="glass-card flex flex-col gap-4 rounded-2xl p-5">
        <p class="flex items-start gap-3 font-display text-[16px] leading-snug font-extrabold text-neutral-light">
          <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-accent-orange text-neutral-light">
            <Icon name="check" class="size-4" />
          </span>
          {benefits.stats.answer}
        </p>
        <Button cta="beneficios-cta" size="md" class="w-full">
          {cta.card}
        </Button>
      </div>
    </div>
  </div>
</Section>

<style>
  /* Vidro sobre o navy: translúcido, com desfoque do blueprint atrás e filete de luz. */
  .glass-card {
    border: 1px solid rgb(255 255 255 / 0.16);
    background: linear-gradient(160deg, rgb(255 255 255 / 0.14) 0%, rgb(255 255 255 / 0.04) 100%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.2),
      0 18px 40px -24px rgb(0 0 0 / 0.6);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
  }
</style>

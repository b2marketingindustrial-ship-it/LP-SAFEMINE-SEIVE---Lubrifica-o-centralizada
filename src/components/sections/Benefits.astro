---
/**
 * "Por que investir" — seção própria desta LP (fase oferta), fora da biblioteca B2.
 *
 * Layout assimétrico: à esquerda, os 6 benefícios como uma lista técnica (linhas com
 * divisória, ícone e marcador que acende no hover); à direita, o painel das duas
 * estatísticas de prevenção, com malha de pontos, a fonte e o CTA.
 */
import Button from '@components/Button.astro'
import Icon from '@components/Icon.astro'
import Section from '@components/Section.astro'
import SplitHeader from '@components/SplitHeader.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { benefits } from '@data/sections/beneficios'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section id="beneficios" tone={tone} rhythm={rhythm}>
  <SplitHeader
    eyebrow={benefits.eyebrow}
    title={benefits.title}
    highlight={benefits.titleHighlight}
    text={benefits.text}
  />

  <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-12">
    <ul class="divide-y divide-primary-dark/10 border-y border-primary-dark/10">
      {benefits.items.map((item) => (
        <li class="benefit group relative grid grid-cols-[auto_minmax(0,1fr)] items-start gap-x-5 py-5 sm:grid-cols-[auto_minmax(0,14rem)_minmax(0,1fr)] sm:items-center sm:gap-x-8">
          <span class="benefit-mark" aria-hidden="true"></span>
          <span class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-primary-dark/[0.06] text-primary-dark-900 transition-colors duration-300 group-hover:bg-accent-orange group-hover:text-neutral-light motion-reduce:transition-none">
            <Icon name={item.icon} class="size-5" />
          </span>
          <h3 class="font-display text-[1.05rem] leading-snug font-extrabold text-primary-dark-900">
            {item.title}
          </h3>
          <p class="col-start-2 mt-1 font-sans text-[15px] leading-snug text-ink-soft sm:col-start-3 sm:mt-0">
            {item.description}
          </p>
        </li>
      ))}
    </ul>

    <aside class="stat-panel relative overflow-hidden rounded-[1.5rem] border border-primary-dark/10 bg-neutral-light p-7 card-shadow sm:p-9">
      <span class="dot-grid-fade pointer-events-none absolute inset-0" aria-hidden="true"></span>
      <div class="relative flex h-full flex-col">
        <dl class="flex flex-col gap-7">
          {benefits.stats.items.map((stat) => (
            <div class="border-l-[1px] border-primary-dark/15 pl-6">
              <dt class="order-2 font-sans text-[15px] leading-snug text-ink-soft">{stat.label}</dt>
              <dd class="font-display text-[3rem] leading-none font-extrabold tracking-[-0.03em] text-accent-orange sm:text-[3.4rem]">
                {stat.value}
              </dd>
            </div>
          ))}
        </dl>
        <p class="mt-7 font-sans text-[12.5px] leading-snug text-ink-soft/80">
          {benefits.stats.source}
        </p>
        <div class="mt-auto pt-8">
          <Button cta="beneficios-cta" size="md" class="w-full sm:w-auto">
            {cta.card}
          </Button>
        </div>
      </div>
    </aside>
  </div>
</Section>

<style>
  /* Marcador verde que entra pela esquerda no hover da linha. */
  .benefit-mark {
    position: absolute;
    top: 50%;
    left: -1.25rem;
    width: 0.75rem;
    height: 2px;
    background: var(--color-accent-orange);
    transform: translateY(-50%) scaleX(0);
    transform-origin: left;
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .benefit:hover .benefit-mark {
    transform: translateY(-50%) scaleX(1);
  }

  /* Rótulo abaixo do número: o <dl> inverte a ordem visual sem mudar a leitura. */
  .stat-panel dl > div {
    display: flex;
    flex-direction: column;
  }

  .stat-panel dd {
    order: 1;
  }

  .stat-panel dt {
    margin-top: 0.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .benefit-mark {
      transition: none;
    }
  }
</style>

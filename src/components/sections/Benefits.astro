---
/**
 * "Por que investir" — seção própria desta LP (fase prova), fora da biblioteca B2.
 *
 * Simplificada em 02/11/2026 (o usuário achou a lista em 3 colunas densa): os 6
 * benefícios numa grade 3×2 de itens curtos (ícone, título, uma frase) e, abaixo, uma
 * faixa navy só com as duas estatísticas, a fonte e o CTA.
 */
import Button from '@components/Button.astro'
import Icon from '@components/Icon.astro'
import Section from '@components/Section.astro'
import SplitHeader from '@components/SplitHeader.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { benefits } from '@data/sections/beneficios'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section id="beneficios" tone={tone} rhythm={rhythm} class="rounded-t-[2rem] sm:rounded-t-[3rem]">
  <SplitHeader
    eyebrow={benefits.eyebrow}
    title={benefits.title}
    highlight={benefits.titleHighlight}
    text={benefits.text}
  />

  <ul class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
    {benefits.items.map((item) => (
      <li class="flex items-start gap-4">
        <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-neutral-light text-accent-orange card-shadow">
          <Icon name={item.icon} class="size-5" />
        </span>
        <span>
          <h3 class="font-display text-[1.05rem] leading-snug font-extrabold text-primary-dark-900">
            {item.title}
          </h3>
          <p class="mt-1 font-sans text-[15px] leading-snug text-ink-soft">{item.description}</p>
        </span>
      </li>
    ))}
  </ul>

  <div class="stats-band relative mt-12 overflow-hidden rounded-[1.5rem] px-6 py-7 sm:px-10 lg:px-12">
    <span class="blueprint-grid pointer-events-none absolute inset-0" aria-hidden="true"></span>
    <div class="relative grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] lg:items-center lg:gap-10">
      {benefits.stats.items.map((stat) => (
        <p class="flex items-center gap-5">
          <span class="shrink-0 font-display text-[2.6rem] leading-none font-extrabold tracking-[-0.03em] text-accent-orange-light tabular-nums">
            {stat.value}
          </span>
          <span class="font-sans text-[15px] leading-snug text-neutral-light/85">{stat.label}</span>
        </p>
      ))}
      <Button cta="beneficios-cta" size="md" class="self-start lg:self-auto">
        {cta.card}
      </Button>
    </div>
    <p class="relative mt-5 font-sans text-[12.5px] text-neutral-light/55">
      {benefits.stats.source}
    </p>
  </div>
</Section>

<style>
  .stats-band {
    background: linear-gradient(
      160deg,
      var(--color-primary-dark-800) 0%,
      var(--color-primary-dark-900) 70%
    );
  }
</style>

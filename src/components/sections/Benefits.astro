---
/**
 * "Por que investir" — seção própria desta LP (fase oferta), fora da biblioteca B2.
 * 6 benefícios em cards com ícone e, abaixo, a faixa das estatísticas de prevenção com
 * a fonte e o CTA.
 */
import Button from '@components/Button.astro'
import Icon from '@components/Icon.astro'
import Section from '@components/Section.astro'
import SplitHeader from '@components/SplitHeader.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { benefits } from '@data/sections/beneficios'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section id="beneficios" tone={tone} rhythm={rhythm}>
  <SplitHeader
    eyebrow={benefits.eyebrow}
    title={benefits.title}
    highlight={benefits.titleHighlight}
    text={benefits.text}
  />

  <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {benefits.items.map((item) => (
      <li class="flex gap-5 rounded-2xl border border-primary-dark/10 bg-neutral-light p-6 shadow-[0_14px_34px_-26px_rgba(10,29,77,0.35)]">
        <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-accent-orange/10 text-accent-orange">
          <Icon name={item.icon} class="size-6" />
        </span>
        <span>
          <h3 class="font-display text-[1.1rem] leading-snug font-extrabold text-primary-dark-900">
            {item.title}
          </h3>
          <p class="mt-1.5 font-sans text-[15px] leading-snug text-ink-soft">{item.description}</p>
        </span>
      </li>
    ))}
  </ul>

  <div class="mt-6 grid gap-6 rounded-2xl border border-primary-dark/10 bg-primary-dark/[0.04] px-6 py-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] lg:items-center lg:gap-10 lg:px-10">
    {benefits.stats.items.map((stat) => (
      <p class="flex items-center gap-5">
        <span class="shrink-0 font-display text-[2.4rem] leading-none font-extrabold text-accent-orange">
          {stat.value}
        </span>
        <span class="font-sans text-[15px] leading-snug text-ink-soft">{stat.label}</span>
      </p>
    ))}
    <Button cta="beneficios-cta" size="md" class="self-start lg:self-auto">
      {cta.card}
    </Button>
  </div>

  <p class="mt-3 font-sans text-[12.5px] text-ink-soft/80 sm:text-right">{benefits.stats.source}</p>
</Section>

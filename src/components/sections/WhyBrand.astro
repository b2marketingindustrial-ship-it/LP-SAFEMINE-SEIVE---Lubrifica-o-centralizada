---
/**
 * Diferenciais — fase "autoridade" da biblioteca B2, com o layout do mockup de
 * 29/10/2026 nesta LP (desvio registrado em docs/BRIEFING.md). `npm run compose`
 * sobrescreve este arquivo com o da biblioteca: guarde-o antes de recompor.
 *
 * Frase de autoridade, texto e CTA ao lado de uma foto em card; abaixo, os 5
 * diferenciais num painel navy — o bloco navy da segunda metade da página.
 */
import Button from '@components/Button.astro'
import Eyebrow from '@components/Eyebrow.astro'
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { why } from '@data/sections/diferenciais'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const [firstLine, ...otherLines] = why.titleLines
---

<Section id="diferenciais" tone={tone} rhythm={rhythm}>
  <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.1fr)] lg:gap-14">
    <div>
      <Eyebrow>{why.eyebrow}</Eyebrow>

      <h2 class="mt-4 font-display leading-[1.04] font-extrabold tracking-[-0.025em] text-primary-dark-900 text-[1.75rem] sm:text-[2.1rem] lg:text-[2.1rem] xl:text-[2.4rem]">
        <span class="block">{firstLine}</span>
        <span class="block text-accent-orange">{otherLines.join(' ')}</span>
      </h2>

      <p class="mt-6 max-w-[32rem] font-sans text-[16px] leading-relaxed text-ink-soft sm:text-[17px]">
        {why.text}
      </p>

      <Button cta="diferenciais-cta" size="lg" class="mt-8">
        {cta.primary}
      </Button>

      <p class="mt-7 flex max-w-[24rem] items-center gap-4 font-sans text-[15px] leading-snug text-ink-soft">
        <Icon name="chat" class="size-8 shrink-0 text-primary-dark-900" />
        {why.help}
      </p>
    </div>

    <div class="relative">
      <span
        class="dot-grid pointer-events-none absolute -top-5 -right-5 hidden h-40 w-40 rounded-2xl lg:block"
        aria-hidden="true"
      ></span>
      <Image
        src={why.scene.src}
        alt={why.scene.alt}
        format="webp"
        width={1100}
        loading="lazy"
        decoding="async"
        class="relative aspect-[1.55] w-full rounded-[1.5rem] object-cover panel-shadow"
      />
    </div>
  </div>

  {/* Painel navy com os 5 diferenciais */}
  <div class="navy-panel tech-corners relative mt-8 overflow-hidden rounded-[1.5rem] panel-shadow">
    <span class="blueprint-grid pointer-events-none absolute inset-0" aria-hidden="true"></span>
    <ul
      class="relative grid gap-y-7 px-6 py-8 sm:grid-cols-2 sm:gap-x-8 sm:px-10 lg:grid-cols-5 lg:gap-x-0 lg:px-8 lg:py-9"
      aria-label={`${why.eyebrow}`}
    >
      {why.reasons.map((reason) => (
        <li class="lg:border-l lg:border-white/15 lg:px-6 lg:first:border-l-0 lg:first:pl-0 lg:last:pr-0">
          <div class="flex items-center gap-4">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-full border border-white/15 bg-white/[0.06]">
              <Icon name={reason.icon} class="why-icon size-5" />
            </span>
            <h3 class="font-display text-[17px] leading-snug font-extrabold text-neutral-light">
              {reason.title}
            </h3>
          </div>
          <p class="mt-4 font-sans text-[15px] leading-relaxed text-neutral-light/75">
            {reason.description}
          </p>
        </li>
      ))}
    </ul>
  </div>
</Section>

<style>
  /* Verde da marca (accent-orange-light) nos ícones sobre navy: decorativos, sem texto branco em cima. */
  .navy-panel :global(.why-icon) {
    color: var(--color-accent-orange-light);
  }
</style>

---
/**
 * Linhas de produto — fase "oferta" da biblioteca B2, com o layout do mockup de
 * 29/10/2026 nesta LP (desvio registrado em docs/BRIEFING.md). `npm run compose`
 * sobrescreve este arquivo com o da biblioteca: guarde-o antes de recompor.
 *
 * Cabeçalho em duas colunas (título · texto), 4 cards claros com foto, função e atuação
 * lado a lado, resultado e CTA de largura total. Sem a faixa de ajuda da biblioteca: o bloco
 * "Identificar" logo abaixo já cumpre esse papel. `dark` fica nos dados só pelo contrato.
 */
import Button from '@components/Button.astro'
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import SplitHeader from '@components/SplitHeader.astro'
import Icon from '@components/Icon.astro'
import BrandCarousel from '@components/BrandCarousel.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { productLines } from '@data/sections/linhas'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const lines = productLines.items
---

<Section id="linhas" tone={tone} rhythm={rhythm}>
  <SplitHeader
    eyebrow={productLines.eyebrow}
    title={productLines.title}
    highlight={productLines.titleHighlight}
    text={productLines.text}
  />

  <BrandCarousel />

  {/* A partir de 1280px cada card é um subgrid de 7 linhas: título, descrição, função/atuação e
      resultado ficam na mesma altura nos 4 cards, mesmo com descrições de tamanhos diferentes. */}
  <ul class="mt-10 grid gap-5 sm:grid-cols-2 xl:grid-cols-4 xl:gap-y-0">
    {lines.map((line, index) => (
      <li class="group flex flex-col rounded-2xl border border-primary-dark/10 bg-neutral-light p-5 card-shadow transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:card-shadow-hover motion-reduce:transition-none motion-reduce:hover:translate-y-0 xl:row-span-7 xl:grid xl:grid-rows-subgrid xl:gap-y-0">
        <span class="flex items-center justify-between">
          <span class="rounded-full bg-accent-orange/10 px-3.5 py-1.5 font-sans text-[11px] font-bold tracking-[0.16em] text-accent-orange uppercase">
            {line.tag}
          </span>
          <span
            class="font-sans text-[12px] font-semibold tracking-[0.12em] text-ink-soft/70 tabular-nums"
            aria-hidden="true"
          >
            {String(index + 1).padStart(2, '0')}/{String(lines.length).padStart(2, '0')}
          </span>
        </span>

        <div class="surface-plate mt-4 flex h-48 items-center justify-center overflow-hidden rounded-xl border border-primary-dark/[0.06] p-4">
          <Image
            src={line.photo.src}
            alt={line.photo.alt}
            format="webp"
            width={640}
            loading="lazy"
            decoding="async"
            class="max-h-full w-auto max-w-full object-contain mix-blend-multiply transition-transform duration-500 ease-out group-hover:scale-[1.04] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
          />
        </div>

        <h3 class="mt-4 font-display leading-tight font-extrabold text-primary-dark-900 text-[1.2rem]">
          {line.title}
        </h3>
        <p class="mt-2 font-sans text-[15px] leading-snug text-ink-soft">{line.description}</p>

        <dl class="mt-5 grid grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] border-b border-primary-dark/10 pb-4">
          <div class="pr-2.5">
            <dt class="font-sans text-[11px] font-semibold tracking-[0.14em] text-ink-soft uppercase">
              {productLines.specLabels[0]}
            </dt>
            <dd class="mt-1 font-display text-[16px] font-extrabold tracking-[-0.01em] whitespace-nowrap text-primary-dark-900 xl:text-[17px]">
              {line.features[0]}
            </dd>
          </div>
          <div class="border-l border-primary-dark/15 pl-3.5">
            <dt class="font-sans text-[11px] font-semibold tracking-[0.14em] text-ink-soft uppercase">
              {productLines.specLabels[1]}
            </dt>
            <dd class="mt-1 font-display text-[16px] font-extrabold tracking-[-0.01em] whitespace-nowrap text-primary-dark-900 xl:text-[17px]">
              {line.features[1]}
            </dd>
          </div>
        </dl>

        <p class="mt-4 flex items-center gap-3 font-sans text-[15px] text-ink">
          <Icon name="check" class="size-7 shrink-0 text-accent-orange" />
          {line.features[2]}
        </p>

        {/* mt-auto alinha os botões na base quando os textos têm alturas diferentes */}
        <div class="mt-auto pt-5">
          <Button cta={`linhas-${line.id}`} size="md" class="w-full">
            {cta.card}
          </Button>
        </div>
      </li>
    ))}
  </ul>

  <p class="mt-5 font-sans text-[12.5px] text-ink-soft/80 sm:text-right">{productLines.note}</p>
</Section>

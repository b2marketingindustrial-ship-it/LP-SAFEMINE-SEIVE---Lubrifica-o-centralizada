---
/**
 * Linhas de produto — fase "oferta" da biblioteca B2, com o layout do mockup de
 * 29/10/2026 nesta LP (desvio registrado em docs/BRIEFING.md). `npm run compose`
 * sobrescreve este arquivo com o da biblioteca: guarde-o antes de recompor.
 *
 * Cabeçalho em duas colunas (título · texto), 4 cards claros com foto, função e atuação
 * lado a lado e resultado; sob o grid, só a nota (sem CTA desde 03/11/2026). Sem a faixa de ajuda da biblioteca: o bloco
 * "Identificar" logo abaixo já cumpre esse papel. `dark` fica nos dados só pelo contrato.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import SplitHeader from '@components/SplitHeader.astro'
import Icon from '@components/Icon.astro'
import BrandCarousel from '@components/BrandCarousel.astro'
import type { SectionProps } from '@lib/layout'
import { productLines, type ProductLine } from '@data/sections/linhas'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const lines: readonly ProductLine[] = productLines.items
---

<Section id="linhas" tone={tone} rhythm={rhythm}>
  <SplitHeader
    eyebrow={productLines.eyebrow}
    title={productLines.title}
    highlight={productLines.titleHighlight}
    text={productLines.text}
  />

  <BrandCarousel />

  {/* A partir de 1280px cada card é um subgrid de 6 linhas: título, descrição, função/atuação e
      resultado ficam na mesma altura nos 4 cards, mesmo com descrições de tamanhos diferentes. */}
  <ul class="mt-10 grid gap-5 sm:grid-cols-2 xl:grid-cols-4 xl:gap-y-0">
    {lines.map((line) => (
      <li class="group flex flex-col overflow-hidden rounded-2xl border border-primary-dark/10 bg-neutral-light card-shadow transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:card-shadow-hover motion-reduce:transition-none motion-reduce:hover:translate-y-0 xl:row-span-6 xl:grid xl:grid-rows-subgrid xl:gap-y-0">
        {/* Foto ocupando todo o topo do card; recorte transparente vai centrado sobre a placa. */}
        <div
          class:list={[
            'relative aspect-[4/3] overflow-hidden',
            line.fit === 'contain' ? 'surface-plate' : 'bg-primary-dark-900',
          ]}
        >
          <Image
            src={line.photo.src}
            alt={line.photo.alt}
            format="webp"
            width={640}
            loading="lazy"
            decoding="async"
            class:list={[
              'h-full w-full transition-transform duration-500 ease-out group-hover:scale-[1.05] motion-reduce:transition-none motion-reduce:group-hover:scale-100',
              line.fit === 'contain' ? 'object-contain p-6' : 'object-cover',
            ]}
          />
          <span class="absolute inset-x-0 top-0 flex items-center p-4">
            <span class="rounded-full bg-neutral-light/95 px-3 py-1.5 font-sans text-[11px] font-bold tracking-[0.14em] text-accent-orange uppercase shadow-[0_6px_14px_-8px_rgb(0_0_0/0.5)]">
              {line.tag}
            </span>
          </span>
        </div>

        <h3 class="px-5 pt-5 font-display text-[1.15rem] leading-tight font-extrabold text-primary-dark-900">
          {line.title}
        </h3>
        <p class="px-5 pt-2 font-sans text-[15px] leading-snug text-ink-soft">{line.description}</p>

        <dl class="mx-5 mt-5 grid grid-cols-2 gap-2">
          <div class="rounded-lg bg-neutral-gray-100 px-3 py-2.5">
            <dt class="font-sans text-[10.5px] font-semibold tracking-[0.14em] text-ink-soft uppercase">
              {productLines.specLabels[0]}
            </dt>
            <dd class="mt-0.5 font-display text-[15px] font-extrabold text-primary-dark-900">
              {line.features[0]}
            </dd>
          </div>
          <div class="rounded-lg bg-neutral-gray-100 px-3 py-2.5">
            <dt class="font-sans text-[10.5px] font-semibold tracking-[0.14em] text-ink-soft uppercase">
              {productLines.specLabels[1]}
            </dt>
            <dd class="mt-0.5 font-display text-[15px] font-extrabold text-primary-dark-900">
              {line.features[1]}
            </dd>
          </div>
        </dl>

        <p class="mx-5 mt-4 mb-5 flex items-center gap-2.5 font-sans text-[14.5px] text-ink">
          <Icon name="check" class="size-5 shrink-0 text-accent-orange" />
          {line.features[2]}
        </p>
      </li>
    ))}
  </ul>

  {/* Sem CTA (pedido do usuário, 03/11/2026): só a nota sob o grid. */}
  <p class="mt-8 font-sans text-[14px] text-ink-soft">{productLines.note}</p>
</Section>

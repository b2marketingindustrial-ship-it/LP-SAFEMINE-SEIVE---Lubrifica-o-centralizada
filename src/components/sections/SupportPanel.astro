---
/**
 * Painel de apoio à identificação — fase "apoio" da biblioteca B2, com o layout do
 * mockup de 29/10/2026 nesta LP (desvio registrado em docs/BRIEFING.md).
 * `npm run compose` sobrescreve este arquivo com o da biblioteca: guarde-o antes.
 *
 * Card dividido a partir de 1280px (abaixo, empilhado): placa clara à esquerda (título,
 * texto, CTA e reforço; deixou de ser navy em 02/11/2026, quando o "processo" virou o bloco
 * navy da fase) e, à direita, os 6 dados em dois grupos:
 * o essencial e o "se souber" (`list.optionalFrom`).
 */
import Button from '@components/Button.astro'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { supportPanel } from '@data/sections/identificar'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const { list } = supportPanel
---

<Section id="identificar" tone={tone} rhythm={rhythm}>
  <div class="grid overflow-hidden rounded-[1.5rem] border border-primary-dark/10 bg-neutral-light card-shadow xl:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
    {/* Bloco navy */}
    <div class="support-lead relative flex flex-col justify-center px-6 py-10 sm:px-10 sm:py-12 xl:px-14 xl:py-14">
      <span class="blueprint-light pointer-events-none absolute inset-0" aria-hidden="true"></span>
      <span class="relative inline-flex items-center gap-4 font-sans text-[12px] font-semibold tracking-[0.16em] text-ink-soft uppercase sm:text-[13px]">
        <span class="h-[3px] w-8 shrink-0 rounded-full bg-accent-orange" aria-hidden="true"></span>
        {supportPanel.eyebrow}
      </span>

      <h2 class="relative mt-4 max-w-[26rem] font-display leading-[1.06] font-extrabold tracking-[-0.02em] text-primary-dark-900 text-[1.75rem] sm:text-[2.1rem] lg:text-[2.1rem] xl:text-[2.4rem]">
        {supportPanel.title}
      </h2>

      <p class="relative mt-5 max-w-[30rem] font-sans text-[16px] leading-relaxed text-ink-soft sm:text-[18px]">
        {supportPanel.text}
      </p>

      <Button cta="identificar-cta" size="lg" class="relative mt-8 w-full max-w-[30rem]">
        {supportPanel.ctaLabel}
      </Button>

      <p class="relative mt-6 flex items-center gap-3 font-sans text-[14px] text-ink-soft sm:text-[15px]">
        <Icon name="chat" class="size-6 shrink-0 text-primary-dark-900" />
        {supportPanel.microcopy}
      </p>
    </div>

    {/* Lado claro: o que enviar, como checklist em duas colunas */}
    <div class="px-6 py-10 sm:px-10 sm:py-12 xl:px-12 xl:py-14">
      <h3 class="font-display text-[1.3rem] leading-tight font-extrabold text-primary-dark-900 sm:text-[1.5rem]">
        {list.title}
      </h3>
      <p class="mt-2 font-sans text-[15px] leading-snug text-ink-soft sm:text-[16px]">
        {list.text}
      </p>

      <ul class="mt-7 grid gap-x-8 sm:grid-cols-2" aria-label={list.title}>
        {supportPanel.items.map((item, i) => (
          <li class="flex items-center gap-4 border-b border-primary-dark/10 py-4">
            <span
              class:list={[
                'flex size-10 shrink-0 items-center justify-center rounded-full',
                i < list.optionalFrom
                  ? 'bg-accent-orange text-neutral-light'
                  : 'bg-primary-dark/[0.06] text-primary-dark-900',
              ]}
            >
              <Icon name={item.icon} class="size-5" />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block font-display text-[15.5px] font-extrabold text-primary-dark-900">
                {item.label}
              </span>
              <span class="block font-sans text-[14px] text-ink-soft">{item.hint}</span>
            </span>
            {i >= list.optionalFrom && (
              <span class="shrink-0 rounded-full bg-primary-dark/[0.05] px-2.5 py-1 font-sans text-[11px] font-semibold tracking-[0.06em] text-ink-soft uppercase">
                {list.optionalLabel}
              </span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>

<style>
  /* Lado do texto: placa com a malha de blueprint, separada do checklist. */
  .support-lead {
    background-color: #f3f5fa;
    border-right: 1px solid rgb(10 29 77 / 0.1);
  }

  @media (width < 80rem) {
    .support-lead {
      border-right: 0;
      border-bottom: 1px solid rgb(10 29 77 / 0.1);
    }
  }
</style>
